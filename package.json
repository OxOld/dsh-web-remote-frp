{
  "name": "dsh-web-remote-frp",
  "version": "1.6.0",
  "description": "DSH 手机/外网远程访问插件（frp 版）：frp 内网穿透公网隧道（frpc 一键下载）+ token 鉴权代理 + gzip 压缩 + 局域网 HTTP/HTTPS 直连 + 常驻手机图标面板 + 六大机器人通道（微信/QQ/Telegram/钉钉/飞书/企业微信）。",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check lib/index.mjs && node test/test-dist.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "remote",
    "frp",
    "frpc",
    "tunnel",
    "qq",
    "napcat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casually/dsh-web-remote-frp.git"
  },
  "homepage": "https://github.com/Casually/dsh-web-remote-frp#readme",
  "bugs": {
    "url": "https://github.com/Casually/dsh-web-remote-frp/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
